#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "icon.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID: declares DPI awareness and the
// common controls dependency. The linker is told not to make its own.
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Avito Watcher"
            VALUE "FileDescription",  "Avito listings watcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AvitoWatcher"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "AvitoWatcher.exe"
            VALUE "ProductName",      "Avito Watcher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
